# Copia este archivo como .env y pon tus keys de la cuenta paper del hackathon.
# Las keys se generan en app.alpaca.markets con la cuenta paper seleccionada
# (recuadro "API Keys" en la columna derecha del dashboard).
# El .env esta en .gitignore y NUNCA debe llegar al repo (es publico).
ALPACA_API_KEY=PK_TU_KEY_AQUI
ALPACA_SECRET_KEY=TU_SECRET_AQUI

# Paper trading SIEMPRE. Nunca cambiar a false en este proyecto:
# config.validar() se niega a arrancar si esto es false.
ALPACA_PAPER_TRADE=true

# --- Capa de decision IA (Featherless, API OpenAI-compatible) ---
# Sin key el agente sigue funcionando: cada senal GO resuelve a PASS y queda
# journaleada como LLM_SIN_KEY. La IA nunca es necesaria para PROTEGER.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324
FEATHERLESS_BASE=https://api.featherless.ai/v1

# --- Operacion ---
# sombra = decide y journalea SIN mandar ordenes  (por defecto, y lo unico
#          que el codigo arranca solo)
# real   = manda ordenes a la cuenta paper        (lo lanza Paul a mano)
# El replay historico completo queda bloqueado hasta disponer de fixtures de
# opciones/LLM; validar_senal.py reproduce hoy la capa determinista de senal.
MODO=sombra

# Universo. Coma-separado.
SIMBOLOS=SPY

# Feed de market data. En cuentas paper lo normal es iex.
FEED=iex
